{
  "name": "agent-linked-parallel-example",
  "package": "com.moonkey.androidagent",
  "steps": [
    {
      "name": "Reset app",
      "action": "force_stop"
    },
    {
      "name": "Launch app",
      "action": "start_app"
    },
    {
      "name": "Wait for agent to begin acting",
      "action": "wait_for_text",
      "text": "Takeover",
      "timeout_ms": 20000,
      "interval_ms": 1000
    },
    {
      "name": "Verify Running state: Takeover button visible",
      "action": "assert_text",
      "text": "Takeover",
      "continue_on_fail": true
    },
    {
      "name": "Observe transition",
      "action": "wait",
      "ms": 1200
    },
    {
      "name": "Tap Takeover",
      "action": "tap_desc",
      "desc": "Takeover",
      "retries": 3,
      "retry_interval_ms": 1000,
      "continue_on_fail": true
    },
    {
      "name": "Wait for Takeover confirmation",
      "action": "wait",
      "ms": 2000
    },
    {
      "name": "Tap Add note if available",
      "action": "tap_text",
      "text": "Add note",
      "retries": 2,
      "retry_interval_ms": 800,
      "continue_on_fail": true
    },
    {
      "name": "Type supplement during active task",
      "action": "type",
      "text": "User intervention during active agent task.",
      "submit": false,
      "continue_on_fail": true
    }
  ]
}
