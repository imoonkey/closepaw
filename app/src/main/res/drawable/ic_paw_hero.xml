<?xml version="1.0" encoding="utf-8"?>
<!-- Hero (large-size) variant of the paw mark. Same paths as ic_paw.xml but
     with strokeWidth 2.0 instead of 3.4, so at 200dp+ sizes the stroke reads
     proportionally to the source logo. Use this only for hero placements
     (EmptyState background, marketing surfaces). Small UI keeps ic_paw.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="144dp"
    android:viewportWidth="60"
    android:viewportHeight="72">

    <group
        android:translateX="4"
        android:translateY="4">

    <!-- Toe 1 (far left, tilted -18°) -->
    <group
        android:pivotX="5.85"
        android:pivotY="19.45"
        android:rotation="-18">
        <path
            android:pathData="M 1.5,19.45 a 4.35,6.95 0 1,0 8.7,0 a 4.35,6.95 0 1,0 -8.7,0 Z"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.0"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"/>
    </group>

    <!-- Toe 2 (inner left, upright) -->
    <path
        android:pathData="M 13.95,9.15 a 4.35,8.05 0 1,0 8.7,0 a 4.35,8.05 0 1,0 -8.7,0 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- Toe 3 (inner right, upright) -->
    <path
        android:pathData="M 29.25,9.15 a 4.35,8.05 0 1,0 8.7,0 a 4.35,8.05 0 1,0 -8.7,0 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- Toe 4 (far right, tilted +18°) -->
    <group
        android:pivotX="45.95"
        android:pivotY="19.45"
        android:rotation="18">
        <path
            android:pathData="M 41.6,19.45 a 4.35,6.95 0 1,0 8.7,0 a 4.35,6.95 0 1,0 -8.7,0 Z"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.0"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"/>
    </group>

    <!-- Open C-spiral body, ending in inner curl -->
    <path
        android:pathData="M 33.1,58.8 C 29.8,61.7 25.5,63.4 20.9,62.4 C 12.4,60.6 7.4,52.7 7.8,43.7 C 8.3,33.9 15.2,26.2 25.7,25.1 C 35.8,24.1 41.7,31.6 40.7,40.3 C 39.9,47.2 34.1,51.6 28.6,49.8 C 27.3,49.4 26.3,48.7 25.6,48.3"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    </group>
</vector>
